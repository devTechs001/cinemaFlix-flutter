# BACKEND_URL=https://cinemaflix-api.onrender.com
# RENDER_BACKEND_URL=https://cinemaflix-api.onrender.com

# Android emulator: BACKEND_URL=http://10.0.2.2:3000
# Physical device on LAN: BACKEND_URL=http://192.168.x.x:3000
