# Copy this file to `.env` and fill in your Supabase project values.
# Find them in: Supabase Dashboard -> Project Settings -> API.
# The anon key is a public (publishable) key, but keep real projects'
# Row Level Security policies tight — the app is only as safe as your RLS.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Node/Express API — local dev
BACKEND_URL=http://localhost:3000
RENDER_BACKEND_URL=http://localhost:3000

# Production (after deploying backend to Render):
# BACKEND_URL=https://cinemaflix-api.onrender.com
# RENDER_BACKEND_URL=https://cinemaflix-api.onrender.com

# Android emulator: BACKEND_URL=http://10.0.2.2:3000
# Physical device on LAN: BACKEND_URL=http://192.168.x.x:3000

# Backend admin endpoints (`x-admin-code` header). REQUIRED in production:
# if unset, the backend generates a random code and prints it to the
# server console on boot — there is no shared default anymore.
ADMIN_CODE=

# Developer-panel access code (Dev Panel "unlock" input + client gates).
# This is a client-side convenience only — server-side protection is
# ADMIN_CODE above. Rotate the demo value before shipping.
DEV_ACCESS_CODE=cinemaflix-dev
